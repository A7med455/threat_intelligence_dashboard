def analyze_threat(ip_data):

    score   = ip_data.get("score", 0)
    reports = ip_data.get("reports", 0)

    extra_note = ""  # start empty, may be filled below
    if score == 0:
        risk_level     = "Safe"
        color          = "green"
        emoji          = "✅"
        recommendation = "No threat detected. IP has a clean record."
    elif score < 25:
        risk_level     = "Low Risk"
        color          = "blue"
        emoji          = "🔵"
        recommendation = "Minor reports. Exercise caution and monitor activity."
    elif score < 50:
        risk_level     = "Suspicious"
        color          = "orange"
        emoji          = "⚠️"
        recommendation = "Multiple reports. Investigate this IP before engaging."
    elif score < 75:
        risk_level     = "High Risk"
        color          = "red"
        emoji          = "❌"
        recommendation = "High risk. Avoid interaction and consider blocking."
    else:
        risk_level     = "Dangerous"
        color          = "darkred"
        emoji          = "🚨"
        recommendation = "Critical threat. Immediate action required. Block and report."
    if reports > 500 and score < 50:
        extra_note = (
            " Note: Despite the high number of reports, the abuse score is relatively low."
            " This could indicate a false positive or that the IP was cleaned up recently."
            " Still, exercise caution and monitor closely."
        )
    return {
        "ip":             ip_data.get("ip", "Unknown"),
        "score":          score,
        "reports":        reports,
        "country":        ip_data.get("country", "Unknown"),
        "isp":            ip_data.get("isp", "Unknown"),
        "domain":         ip_data.get("domain", "N/A"),
        "risk_level":     risk_level,
        "color":          color,
        "emoji":          emoji,
        "recommendation": recommendation + extra_note,
    }

def classify_score_label(score):
    if score == 0:       return "Safe"
    elif score < 25:     return "Low Risk"
    elif score < 50:     return "Suspicious"
    elif score < 75:     return "High Risk"
    else:                return "Dangerous"


def get_score_color(score):
    if score == 0:       return "#22c55e"   # green
    elif score < 25:     return "#3b82f6"   # blue
    elif score < 50:     return "#f97316"   # orange
    elif score < 75:     return "#ef4444"   # red
    else:                return "#7f1d1d"   # dark red
